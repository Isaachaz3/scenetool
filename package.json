{
  "name": "vtt-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/ruslan-display": "5.3.0",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "immer": "10.2.0",
    "konva": "9.3.22",
    "lucide-react": "0.577.0",
    "nanoid": "5.1.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
